<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.CreativePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ROW 0: TOP BRAND BAR & DIVISION NAVIGATION                 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: SPARK Creativity Suite Brand & Mascot -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Setup/SparkMascot.png" Width="36" Height="36"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="SPARK Creativity Suite" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Creativity Mode" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Unified Creative Software Ecosystem • 16 Creative Applications • 240 Professional Skills"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="ActiveAppBadge" Text="Active: PhotoSpark" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="ModelBadge" Text="Model: Auto (Smart Creative Router)" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Ecosystem Ready (16 Apps Tested)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Global Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ManualEditingTopButton" Click="OnManualEditingClicked" ToolTipService.ToolTip="Launch native application window for deep manual editing">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7AC;" FontSize="14"/>
                            <TextBlock Text="Manual Editing" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnNewProjectClicked" ToolTipService.ToolTip="Create new creative project">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </Button>
                    <Button Click="OnSaveProjectClicked" ToolTipService.ToolTip="Save project">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ROW 1: THREE-PANE CREATIVE WORKSPACE                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────────────────────── -->
            <!-- PANE 1: LEFT SIDEBAR (16 APPS CATALOG & PROJECTS)           -->
            <!-- ─────────────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Apps Header & Filter -->
                    <StackPanel Grid.Row="0" Padding="14,12,14,8" Spacing="8">
                        <TextBlock Text="Creative Applications" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="AppSearchBox" PlaceholderText="Filter 16 applications..." TextChanged="OnAppSearchTextChanged"/>
                    </StackPanel>

                    <!-- 16 Applications List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="ApplicationsListView" SelectionChanged="OnApplicationSelectionChanged" Padding="6,2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconAssetPath}" Width="28" Height="28" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding PrimaryCapability}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- Bottom Sidebar: Dedicated Manual Editing & Asset Exchange -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel Spacing="8">
                            <Button x:Name="ManualEditingSidebarButton" Click="OnManualEditingClicked" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7AC;" FontSize="16"/>
                                    <TextBlock Text="Manual Editing (Native)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnAssetExchangeClicked" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                                    <TextBlock Text="Cross-App Handoff"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─────────────────────────────────────────────────────────── -->
            <!-- PANE 2: CENTRAL INTERACTIVE APPLICATION WORKSPACE           -->
            <!-- ─────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Workspace App Header -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image x:Name="ActiveAppIcon" Source="ms-appx:///Assets/Setup/SparkMascot.png" Width="40" Height="40"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ActiveAppTitle" Text="PhotoSpark Workspace" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="6,2">
                                        <TextBlock x:Name="ActiveAppStatusText" Text="Integrated &amp; Verified" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ActiveAppAttribution" Text="Upstream: PhotoCraft (Rust/egui) • License: MIT OR Apache-2.0 • Offline Ready" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnInspectDocumentClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12"/>
                                    <TextBlock Text="Inspect"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnManualEditingClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7AC;" FontSize="12"/>
                                    <TextBlock Text="Native Window"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Application Toolbar -->
                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Standard Editing Tools -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <Button ToolTipService.ToolTip="Select / Move Tool (V)"><FontIcon Glyph="&#xEF20;" FontSize="13"/></Button>
                            <Button ToolTipService.ToolTip="Path / Pen Tool (P)"><FontIcon Glyph="&#xE70F;" FontSize="13"/></Button>
                            <Button ToolTipService.ToolTip="Shape Primitives (U)"><FontIcon Glyph="&#xE7B7;" FontSize="13"/></Button>
                            <Button ToolTipService.ToolTip="Typography Text Tool (T)"><FontIcon Glyph="&#xE8D2;" FontSize="13"/></Button>
                            <Button ToolTipService.ToolTip="Adjustment Layer Stacks"><FontIcon Glyph="&#xE790;" FontSize="13"/></Button>
                            <Button ToolTipService.ToolTip="Eyedropper / Color Picker (I)"><FontIcon Glyph="&#xEF3C;" FontSize="13"/></Button>
                        </StackPanel>

                        <!-- Document Breadcrumb / File Name -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ActiveDocumentName" Text="BrandIdentity_Poster.pcraft" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="(1920 × 1080 • RGBA8 • Non-Destructive)" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <!-- View Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button ToolTipService.ToolTip="Zoom Out"><FontIcon Glyph="&#xE71F;" FontSize="12"/></Button>
                            <TextBlock Text="100%" FontSize="12" VerticalAlignment="Center"/>
                            <Button ToolTipService.ToolTip="Zoom In"><FontIcon Glyph="&#xE71E;" FontSize="12"/></Button>
                            <Button ToolTipService.ToolTip="Toggle Grid Rulers"><FontIcon Glyph="&#xE70B;" FontSize="12"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Central Canvas & Inspector -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Canvas Area -->
                    <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Simulated Canvas Surface with Grid Background -->
                            <Viewbox Stretch="Uniform" Margin="24">
                                <Border Width="960" Height="540" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2">
                                    <Grid>
                                        <!-- Ambient Lighting / Glow -->
                                        <Ellipse Width="380" Height="380" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Active Canvas Artwork Illustration -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                            <Image x:Name="CanvasMascotPreview" Source="ms-appx:///Assets/Setup/SparkMascot.png" Width="180" Height="180" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="CanvasArtTitle" Text="SPARK CREATIVE COMPOSITION" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="CanvasArtSubtitle" Text="Autonomous Non-Destructive Layers • Vector Béziers • Color Gradients" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Viewbox>

                            <!-- Viewport Status Overlay -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock x:Name="CanvasStatusIndicator" Text="Canvas: Active (60 FPS GPU Preview)" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right Inspector: Layers & Properties -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="12,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Layers &amp; Elements" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="2" Padding="6">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7B7;" FontSize="12"/>
                                            <TextBlock Text="Flame Mascot Vector" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="12"/>
                                            <TextBlock Text="Title Typography" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="12"/>
                                            <TextBlock Text="Tone Curves Adjustment" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7B5;" FontSize="12"/>
                                            <TextBlock Text="Background Canvas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Document Properties -->
                            <Border Grid.Row="2" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Dimensions: 1920 × 1080 px" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="Color: 32-bit Float sRGB" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="Format: Native Spark Package" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Status Bar -->
                <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkspaceFooterInfo" Text="Connected to SPARK Shared Application Integration Engine • Ready" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Memory: 142 MB" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="GPU: Hardware Accelerated" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────────────────────────────────────────────────────────── -->
            <!-- PANE 3: RIGHT CREATIVE AGENT PANEL                          -->
            <!-- ─────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Agent Header -->
                    <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="ms-appx:///Assets/Setup/SparkMascot.png" Width="30" Height="30" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SPARK Creative Agent" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Autonomous Creative Operator &amp; Copilot" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Agent Settings: Model & Skill Selector -->
                    <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Spacing="6">
                            <!-- Model Selector -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model:" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox Grid.Column="1" x:Name="ModelSelectorCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnModelSelectionChanged">
                                    <ComboBoxItem Content="Auto (Smart Creative Router)"/>
                                    <ComboBoxItem Content="Gemini 2.5 Pro Vision"/>
                                    <ComboBoxItem Content="Claude 3.7 Sonnet"/>
                                    <ComboBoxItem Content="GPT-4o"/>
                                    <ComboBoxItem Content="Qwen-2.5-Coder (Local Ollama)"/>
                                    <ComboBoxItem Content="Llama-3.3 70B (Local Ollama)"/>
                                </ComboBox>
                            </Grid>

                            <!-- Skill Selector -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Skill:" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox Grid.Column="1" x:Name="SkillSelectorCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSkillSelectionChanged">
                                    <ComboBoxItem Content="Auto (Resolve from Prompt)"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Agent Chat History / Execution Log -->
                    <ScrollViewer Grid.Row="2" x:Name="AgentChatScrollViewer" Padding="14,10">
                        <StackPanel x:Name="AgentChatHistoryPanel" Spacing="12">
                            <!-- Welcome Message -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="SPARK Creative Assistant" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="I am ready to plan, execute, and refine operations across all 16 SPARK creative applications using our 240 professional skills." FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Try slash commands like /apps, /skills, /inspect, or describe what you want to create." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="3" x:Name="AgentProgressBar" IsIndeterminate="True" Visibility="Collapsed"/>

                    <!-- Prompt Composer & Slash Commands -->
                    <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel Spacing="8">
                            <!-- Quick Slash Commands Bar -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="/apps" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                    <Button Content="/skills" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                    <Button Content="/inspect" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                    <Button Content="/manual" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                    <Button Content="/export" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                    <Button Content="/help" Click="OnSlashCommandClicked" FontSize="11" Padding="6,2"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Prompt Box & Send -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AgentPromptBox"
                                         PlaceholderText="Ask Creative Agent to create, edit, or refine..."
                                         AcceptsReturn="True"
                                         MaxHeight="100"
                                         KeyDown="OnAgentPromptKeyDown"/>
                                <Button Grid.Column="1" x:Name="AgentSendButton" Click="OnAgentSendClicked" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Height="36" Width="36" Padding="0">
                                    <FontIcon Glyph="&#xE724;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ROW 2: STATUS INFOBAR FOR NOTIFICATIONS                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <InfoBar Grid.Row="2" x:Name="StatusInfoBar" IsOpen="False" Margin="16,8"/>
    </Grid>
</Page>

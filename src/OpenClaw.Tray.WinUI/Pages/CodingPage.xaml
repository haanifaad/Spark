<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.CodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="MonospaceTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ Top Command Bar & Workspace Selector ════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="Coding Division" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="OpenFolderButton" Click="OnOpenFolderClicked"
                            Style="{StaticResource DefaultButtonStyle}"
                            AutomationProperties.AutomationId="CodingOpenFolder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14"/>
                            <TextBlock Text="Open Project..."/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Workspace Metadata Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4">
                        <TextBlock x:Name="ProjectPathText" Text="No project opened" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </Border>
                    <Border x:Name="TechStackBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4" Visibility="Collapsed">
                        <TextBlock x:Name="TechStackText" Text="Stack" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="GitBranchBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8F4;" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GitBranchText" Text="branch" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AnalyzeButton" Click="OnAnalyzeClicked" ToolTipService.ToolTip="Analyze repository structure and stack">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13"/>
                            <TextBlock Text="Analyze"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunTestsButton" Click="OnRunTestsClicked" ToolTipService.ToolTip="Execute project tests">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13"/>
                            <TextBlock Text="Run Tests"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GitStatusButton" Click="OnGitStatusClicked" ToolTipService.ToolTip="Inspect git status and uncommitted changes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                            <TextBlock Text="Git Status"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReviewButton" Click="OnReviewClicked" ToolTipService.ToolTip="Run automated code review on modified files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="13"/>
                            <TextBlock Text="Review"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ Interactive Approval Banner ════════ -->
        <InfoBar x:Name="ApprovalBar" Grid.Row="1"
                 IsOpen="False" IsClosable="False" Severity="Warning"
                 Title="Permission Approval Required"
                 Message="An autonomous operation requires your approval before modifying files or executing commands.">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ApproveOnceButton" Content="Approve" Click="OnApproveOnceClicked" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="ApproveAlwaysButton" Content="Always Allow for Session" Click="OnApproveAlwaysClicked"/>
                    <Button x:Name="DenyButton" Content="Deny" Click="OnDenyClicked"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- ════════ Agent Activity Progress ════════ -->
        <ProgressBar x:Name="ActivityProgressBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" Height="2"/>

        <!-- ════════ Main Workspace Grid ════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Sidebar: Plan Tracker & Modified Files ── -->
            <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- Implementation Plan Header -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="Implementation Plan" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="PlanProgressText" Text="0/0 (0%)" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="PlanProgressBar" Value="0" Maximum="100"/>
                </StackPanel>

                <!-- Steps List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlanStepsPanel" Spacing="8">
                        <TextBlock x:Name="EmptyPlanText" Text="No active plan. Send a prompt to create an autonomous coding plan."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="4,8,4,8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Modified Files Header -->
                <TextBlock Grid.Row="2" x:Name="ModifiedFilesHeader" Text="Modified Files (0)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,6"/>

                <!-- Modified Files List -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModifiedFilesPanel" Spacing="4">
                        <TextBlock x:Name="EmptyFilesText" Text="No files modified in this session."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="4,4,4,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Splitter -->
            <toolkit:GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"/>

            <!-- ── Right Workspace Detail View ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode Switcher Tabs -->
                <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6,12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="TabChat" Content="Conversation" IsChecked="True" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                        <RadioButton x:Name="TabDiff" Content="File Diff Viewer" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                        <RadioButton x:Name="TabTerminal" Content="Terminal Console" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                        <RadioButton x:Name="TabReview" Content="Code Review" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                    </StackPanel>
                </Border>

                <!-- Tab 1: Conversation -->
                <Grid x:Name="ChatViewHost" Grid.Row="1" Visibility="Visible">
                    <ScrollViewer x:Name="ConversationScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel x:Name="MessagesPanel" Spacing="12">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Welcome to the SPARK Coding Division" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Autonomous software engineering engine with multi-file editing, planning, terminal execution, debugging, test validation, and git integration."
                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Tab 2: File Diff Viewer -->
                <Grid x:Name="DiffViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="DiffFileTitle" Text="Select a file to inspect diff" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="DiffStatsText" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="RevertFileButton" Content="Revert Change" Click="OnRevertFileClicked" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#FF0D0E10" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DiffViewerText" Style="{StaticResource MonospaceTextStyle}" Foreground="#FFE5E5E5" Text="No diff selected."/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Tab 3: Terminal Console -->
                <Grid x:Name="TerminalViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF0D0E10" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TerminalOutputText" Style="{StaticResource MonospaceTextStyle}" Foreground="#FF00FF66" Text="SPARK Terminal Console Initialized."/>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TerminalInputBox" Grid.Column="0" PlaceholderText="Enter terminal command (e.g. dotnet build, npm test)..." KeyDown="OnTerminalInputKeyDown"/>
                        <Button x:Name="TerminalRunButton" Grid.Column="1" Content="Run" Click="OnTerminalRunClicked"/>
                    </Grid>
                </Grid>

                <!-- Tab 4: Code Review -->
                <Grid x:Name="ReviewViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Automated Code Review" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock x:Name="ReviewSummaryText" Text="No review has been conducted yet." Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock x:Name="ReviewScoreText" Text="Score: 100 / 100" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Findings &amp; Recommendations" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <StackPanel x:Name="ReviewFindingsPanel" Spacing="8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom Prompt Bar -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                    <StackPanel Spacing="8">
                        <!-- Quick Prompts Chips -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Understand project" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                            <Button Content="Run test suite" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                            <Button Content="Find potential bugs" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                            <Button Content="Review uncommitted changes" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                        </StackPanel>
                        <!-- Prompt Input -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PromptInputBox" Grid.Column="0"
                                     PlaceholderText="Ask SPARK Coding Division to build, refactor, fix, or test..."
                                     AcceptsReturn="False" KeyDown="OnPromptKeyDown"/>
                            <Button x:Name="SendButton" Grid.Column="1" Click="OnSendClicked" Style="{StaticResource AccentButtonStyle}" Width="44" Height="36">
                                <FontIcon Glyph="&#xE724;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

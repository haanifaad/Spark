<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.CodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="MonospaceTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ Top Command Bar & Workspace Selector ════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="SPARK Code Division" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="OpenFolderButton" Click="OnOpenFolderClicked"
                            Style="{StaticResource DefaultButtonStyle}"
                            AutomationProperties.AutomationId="CodingOpenFolder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14"/>
                            <TextBlock Text="Open Project..."/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Workspace Metadata Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4">
                        <TextBlock x:Name="ProjectPathText" Text="No project opened" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </Border>
                    <Border x:Name="TechStackBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4" Visibility="Collapsed">
                        <TextBlock x:Name="TechStackText" Text="Stack" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="GitBranchBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8F4;" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GitBranchText" Text="branch" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AnalyzeButton" Click="OnAnalyzeClicked" ToolTipService.ToolTip="Analyze repository structure and tech stack">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13"/>
                            <TextBlock Text="Analyze"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunTestsButton" Click="OnRunTestsClicked" ToolTipService.ToolTip="Execute project tests">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13"/>
                            <TextBlock Text="Run Tests"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GitStatusButton" Click="OnGitStatusClicked" ToolTipService.ToolTip="Inspect git status and uncommitted changes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                            <TextBlock Text="Git Status"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReviewButton" Click="OnReviewClicked" ToolTipService.ToolTip="Run automated code review on modified files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="13"/>
                            <TextBlock Text="Review"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ Interactive Approval Banner ════════ -->
        <InfoBar x:Name="ApprovalBar" Grid.Row="1"
                 IsOpen="False" IsClosable="False" Severity="Warning"
                 Title="Permission Approval Required"
                 Message="An autonomous operation requires your approval before modifying files or executing commands.">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ApproveOnceButton" Content="Approve" Click="OnApproveOnceClicked" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="ApproveAlwaysButton" Content="Always Allow for Session" Click="OnApproveAlwaysClicked"/>
                    <Button x:Name="DenyButton" Content="Deny" Click="OnDenyClicked"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- ════════ Agent Activity Progress ════════ -->
        <ProgressBar x:Name="ActivityProgressBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" Height="2"/>

        <!-- ════════ Main Workspace Grid ════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="450"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Sidebar: Plan Tracker & Modified Files ── -->
            <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- Implementation Plan Header -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="Autonomous Plan" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="PlanProgressText" Text="0/0 (0%)" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="PlanProgressBar" Value="0" Maximum="100"/>
                </StackPanel>

                <!-- Steps List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlanStepsPanel" Spacing="8">
                        <TextBlock x:Name="EmptyPlanText" Text="No active plan. Send a prompt to create an autonomous coding plan."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="4,8,4,8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Modified Files Header -->
                <TextBlock Grid.Row="2" x:Name="ModifiedFilesHeader" Text="Modified Files (0)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,6"/>

                <!-- Modified Files List -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModifiedFilesPanel" Spacing="4">
                        <TextBlock x:Name="EmptyFilesText" Text="No files modified in this session."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="4,4,4,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Splitter -->
            <toolkit:GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"/>

            <!-- ── Right Workspace Detail View ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode Switcher Tabs (All 7 Unified Functional Areas) -->
                <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6,12,6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton x:Name="TabChat" Content="AI Workspace" IsChecked="True" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabBuild" Content="Build Anything" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabReverse" Content="Reverse Engineering" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabTerminal" Content="CLI Intelligence" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabAudit" Content="Cybersecurity Audit" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabDiff" Content="File Diff Viewer" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                            <RadioButton x:Name="TabReview" Content="Code Review" Checked="OnTabSelectionChanged" GroupName="WorkspaceTabs"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ════════ Tab 1: AI Development Workspace ════════ -->
                <Grid x:Name="ChatViewHost" Grid.Row="1" Visibility="Visible">
                    <ScrollViewer x:Name="ConversationScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel x:Name="MessagesPanel" Spacing="12">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Welcome to the Unified SPARK Code Division" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Professional-grade AI development workspace integrating autonomous engineering, clean-room building, reverse engineering, CLI intelligence, and cybersecurity auditing."
                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ════════ Tab 2: Build Anything (Craft Anything Integration) ════════ -->
                <Grid x:Name="BuildViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Creation Prompt Card -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Build Anything — Autonomous Project Creator" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Describe any application, site, or microservice. SPARK will generate the working project, detect build outputs, and launch live preview."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BuildPromptBox" Grid.Column="0" PlaceholderText="What do you want to build? (e.g. Interactive Markdown reader with theme switching)..."/>
                                <ComboBox x:Name="ProjectTypeCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="Web Single Page App"/>
                                    <ComboBoxItem Content="Full-Stack Web App"/>
                                    <ComboBoxItem Content="Native Desktop / GUI"/>
                                    <ComboBoxItem Content="Autonomous CLI Tool"/>
                                    <ComboBoxItem Content="Canvas 2D / Creative"/>
                                </ComboBox>
                                <Button x:Name="BtnGenerateProject" Grid.Column="2" Content="Build Project" Click="OnBuildProjectClicked" Style="{StaticResource AccentButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Discovered Output & Live Preview Banner -->
                    <Border x:Name="BuildOutputBanner" Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="BuildOutputSummaryText" Text="Build Output Ready" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="BuildOutputDetailsText" Text="Site output located at dist/index.html" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnOpenOutputFolder" Content="Open Folder" Click="OnOpenBuildOutputFolderClicked"/>
                                <Button x:Name="BtnLaunchPreview" Content="Live Web Preview" Click="OnLaunchBuildPreviewClicked" Style="{StaticResource AccentButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Generated Files Tree / Log -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BuildGeneratedFilesPanel" Spacing="8">
                                <TextBlock Text="Project Artifacts" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="BuildEmptyFilesText" Text="No project generated yet. Enter a specification above to build."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ════════ Tab 3: Reverse Engineering (Rea Integration) ════════ -->
                <Grid x:Name="ReverseViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Reverse Engineering &amp; Architecture Extraction" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Inspect native binaries, .NET assemblies, Electron ASAR bundles, Web bundles, and APKs to extract functional architecture and verifiable evidence."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReverseTargetPathBox" Grid.Column="0" PlaceholderText="Select binary, assembly, ASAR, APK, or bundle file to reverse engineer..."/>
                                <Button x:Name="BtnBrowseReverseTarget" Grid.Column="1" Content="Browse..." Click="OnBrowseReverseTargetClicked"/>
                                <Button x:Name="BtnInspectTarget" Grid.Column="2" Content="Inspect Target" Click="OnInspectTargetClicked" Style="{StaticResource AccentButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Verified Evidence Matrix -->
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReverseEvidencePanel" Spacing="8">
                                    <TextBlock Text="Verified Evidence &amp; Xrefs" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="ReverseEmptyEvidenceText" Text="Select and inspect a target above to extract architectural evidence."
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Clean-Room Specification -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Clean-Room Architecture Specification" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="ReverseSpecText" Style="{StaticResource MonospaceTextStyle}" Text="Clean-room specification will be synthesized here." TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ════════ Tab 4: CLI & Terminal Intelligence (CLI Anything Integration) ════════ -->
                <Grid x:Name="TerminalViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Harness Selector, Category Filter & NL Translator -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="10,8,10,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CLI Hub:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="HarnessCategoryCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnHarnessCategoryChanged" PlaceholderText="All Categories"/>
                                <ComboBox x:Name="HarnessSelectorCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="OnHarnessSelected" PlaceholderText="Select Harness (84+)..."/>
                                <TextBox x:Name="NlToCliBox" Grid.Column="3" PlaceholderText="Translate natural language to CLI (e.g. render blender scene, generate suno music)..." KeyDown="OnNlToCliKeyDown"/>
                                <Button x:Name="BtnNlToCli" Grid.Column="4" Content="Generate CLI" Click="OnNlToCliClicked"/>
                            </Grid>
                            <TextBlock x:Name="HarnessDetailsText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Terminal Console Output -->
                    <Border Grid.Row="1" Background="#FF0D0E10" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TerminalOutputText" Style="{StaticResource MonospaceTextStyle}" Foreground="#FF00FF66" Text="SPARK CLI Intelligence &amp; Terminal Console Initialized."/>
                        </ScrollViewer>
                    </Border>

                    <!-- Input Bar -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TerminalInputBox" Grid.Column="0" PlaceholderText="Enter command line (e.g. dotnet build, git status, cli-anything-blender)..." KeyDown="OnTerminalInputKeyDown"/>
                        <Button x:Name="TerminalRunButton" Grid.Column="1" Content="Run" Click="OnTerminalRunClicked" Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>
                </Grid>

                <!-- ════════ Tab 5: Cybersecurity Audit (Shannon Integration) ════════ -->
                <Grid x:Name="AuditViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Target Configuration & Scope Setup -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA18;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    <TextBlock Text="Cybersecurity Pentest &amp; Vulnerability Assessment" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Name="BtnExportReportMd" Content="Markdown Report" Click="OnExportReportMdClicked"/>
                                    <Button x:Name="BtnExportReportSarif" Content="SARIF Report" Click="OnExportReportSarifClicked"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AuditTargetUrlBox" Grid.Column="0" PlaceholderText="Target URL (e.g. http://localhost:3000)..."/>
                                <TextBox x:Name="AuditRepoPathBox" Grid.Column="1" PlaceholderText="Target Repository (defaults to active project)..."/>
                                <CheckBox x:Name="AuditAuthCheck" Grid.Column="2" Content="Authorized Target Scope" IsChecked="True"/>
                                <Button x:Name="BtnStartAudit" Grid.Column="3" Content="Launch Audit" Click="OnStartAuditClicked" Style="{StaticResource AccentButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Pipeline Progress & Agent Execution Matrix -->
                    <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Name="AuditPhaseLabel" Text="Pipeline Status: Ready (/cyber-security-audit)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="AuditStatsText" Text="0 Verified Findings" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="AuditPhaseProgressBar" Value="0" Maximum="100"/>
                            <!-- Agents Status Row -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AuditAgentsPanel" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Findings Split View -->
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Verified Findings List -->
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AuditFindingsPanel" Spacing="6">
                                    <TextBlock Text="Verified Findings (No Exploit, No Report)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AuditEmptyFindingsText" Text="No findings yet. Launch audit to execute vulnerability scans and exploitation proofs."
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Deep Finding Inspection -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FindingDetailPanel" Spacing="10">
                                    <TextBlock x:Name="FindingDetailTitle" Text="Select a finding to inspect proof-of-concept evidence" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock x:Name="FindingDetailSummary" Text="Verified technical details, affected source files, and remediation guidance will appear here."
                                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FindingDetailEndpoint" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                    <TextBlock Text="Exploitation Steps &amp; Payload" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0"/>
                                    <Border Background="#FF0D0E10" CornerRadius="4" Padding="10">
                                        <TextBlock x:Name="FindingDetailPayload" Style="{StaticResource MonospaceTextStyle}" Foreground="#FFE5E5E5" Text="No payload selected." TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="Proof of Impact" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="FindingDetailImpact" Style="{StaticResource BodyTextBlockStyle}" Text="" TextWrapping="Wrap"/>

                                    <TextBlock Text="Remediation Guidance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="FindingDetailRemediation" Style="{StaticResource BodyTextBlockStyle}" Text="" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ════════ Tab 6: File Diff Viewer ════════ -->
                <Grid x:Name="DiffViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="DiffFileTitle" Text="Select a file to inspect diff" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="DiffStatsText" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="RevertFileButton" Content="Revert Change" Click="OnRevertFileClicked" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#FF0D0E10" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DiffViewerText" Style="{StaticResource MonospaceTextStyle}" Foreground="#FFE5E5E5" Text="No diff selected."/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ════════ Tab 7: Code Review ════════ -->
                <Grid x:Name="ReviewViewHost" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Automated Code Review" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock x:Name="ReviewSummaryText" Text="No review has been conducted yet." Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock x:Name="ReviewScoreText" Text="Score: 100 / 100" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Findings &amp; Recommendations" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <StackPanel x:Name="ReviewFindingsPanel" Spacing="8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ════════ Bottom Prompt Bar ════════ -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                    <StackPanel Spacing="8">
                        <!-- Quick Prompts Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Understand project" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                                <Button Content="Run test suite" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                                <Button Content="Find potential bugs" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                                <Button Content="/cyber-security-audit" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <Button Content="/build interactive web app" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                                <Button Content="/cli list harnesses" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                                <Button Content="/reverse-engineer target" Click="OnQuickPromptClicked" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,4"/>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Prompt Input -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PromptInputBox" Grid.Column="0"
                                     PlaceholderText="Ask SPARK Code Division or type slash command (e.g. /cyber-security-audit, /build, /cli)..."
                                     AcceptsReturn="False" KeyDown="OnPromptKeyDown"/>
                            <Button x:Name="SendButton" Grid.Column="1" Click="OnSendClicked" Style="{StaticResource AccentButtonStyle}" Width="44" Height="36">
                                <FontIcon Glyph="&#xE724;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

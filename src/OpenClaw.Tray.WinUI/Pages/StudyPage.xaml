<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.StudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="MonospaceTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Row 0: Top Command Bar & Division Title ═════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Division Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82D;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Study Division" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Universal AI Education &amp; Core Learning System" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4">
                        <TextBlock x:Name="ActiveCourseBadge" Text="Active: Computer Science Foundations" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4">
                        <TextBlock x:Name="ActiveSessionBadge" Text="Session: Ready" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4,8,4">
                        <TextBlock x:Name="MasteryBadge" Text="Mastery: Novice" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="NewSessionButton" Click="OnNewSessionClicked" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13"/>
                            <TextBlock Text="New Session"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh curriculum and progress">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ Row 1: Teaching Controls Bar (Level, Mode, Language) ═════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Level Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Level:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LevelComboBox" SelectionChanged="OnLevelSelectionChanged" MinWidth="130" Height="32">
                        <ComboBoxItem Content="School"/>
                        <ComboBoxItem Content="HigherSecondary"/>
                        <ComboBoxItem Content="College"/>
                        <ComboBoxItem Content="University" IsSelected="True"/>
                        <ComboBoxItem Content="Professional"/>
                        <ComboBoxItem Content="Technical"/>
                        <ComboBoxItem Content="Research"/>
                    </ComboBox>
                </StackPanel>

                <!-- Teaching Mode Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Mode:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="TeachingModeComboBox" SelectionChanged="OnTeachingModeSelectionChanged" MinWidth="140" Height="32">
                        <ComboBoxItem Content="Beginner"/>
                        <ComboBoxItem Content="Standard" IsSelected="True"/>
                        <ComboBoxItem Content="Detailed"/>
                        <ComboBoxItem Content="Advanced"/>
                        <ComboBoxItem Content="StepByStep"/>
                        <ComboBoxItem Content="Socratic"/>
                        <ComboBoxItem Content="Practical"/>
                        <ComboBoxItem Content="Revision"/>
                    </ComboBox>
                </StackPanel>

                <!-- Language Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Language:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageComboBox" SelectionChanged="OnLanguageSelectionChanged" MinWidth="120" Height="32">
                        <ComboBoxItem Content="English" IsSelected="True"/>
                        <ComboBoxItem Content="Malayalam (മലയാളം)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Status text / Active Topic -->
                <TextBlock x:Name="ActiveTopicIndicator" Grid.Column="3" Text="Topic: Algorithms and Complexity" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Right: Toggle Session Resumption Drawer -->
                <Button x:Name="ResumeDrawerButton" Grid.Column="4" Click="OnToggleSessionsDrawerClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81C;" FontSize="13"/>
                        <TextBlock Text="Past Sessions"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═════════ Row 2: Progress & Error Infobar ═════════ -->
        <StackPanel Grid.Row="2">
            <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Informational" IsClosable="True" Margin="16,8,16,0"/>
        </StackPanel>

        <!-- ═════════ Row 3: Study Workspace Shell ═════════ -->
        <Grid Grid.Row="3" Margin="16,10,16,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Curriculum & Objectives & Sessions ── -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header with Pivot-style tabs -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Text="Curriculum &amp; Objectives" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <!-- Objectives Card -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Active Learning Objectives" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                                <StackPanel x:Name="ObjectivesListPanel" Spacing="3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Course / Session List Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Enrolled Courses &amp; Modules" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                            <StackPanel x:Name="CoursesPanel" Spacing="6"/>

                            <TextBlock x:Name="PastSessionsHeader" Text="Previous Learning Sessions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <StackPanel x:Name="PastSessionsPanel" Spacing="4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Stats -->
                    <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Study Streak: 1 Day" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompletedLessonsText" Text="0 lessons completed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Right Column: Learning Stage & Interactive AI Tutor ── -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stage Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="ActiveLessonTitle" Text="Interactive Learning Stage" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:Name="ActiveLessonSummary" Text="Select a topic to start or ask a question directly to the AI Tutor." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,3,6,3" VerticalAlignment="Center">
                            <TextBlock x:Name="ModelRoutingBadge" Text="Model: Local / Balanced" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Empty State View -->
                    <Border x:Name="EmptyStateCard" Grid.Row="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="32"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="560"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <FontIcon Glyph="&#xE82D;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Welcome to SPARK AI Tutor" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="The AI Tutor provides adaptive pedagogical instruction across 8 teaching modes (Standard, Socratic, Step-by-Step, Practical, and more) with English and Malayalam support."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Explain Big-O" Click="OnPromptSampleClicked"/>
                                <Button Content="Guide Me: Recursion" Click="OnPromptSampleClicked"/>
                                <Button Content="Quiz Me (Socratic)" Click="OnPromptSampleClicked"/>
                                <Button Content="In Malayalam (മലയാളം)" Click="OnPromptSampleClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Session Messages List -->
                    <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MessagesPanel" Spacing="10"/>
                    </ScrollViewer>

                    <!-- Stage Prompt Input Box -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PromptTextBox"
                                 Grid.Column="0"
                                 PlaceholderText="Ask the AI Tutor a question (e.g., 'Explain binary search step by step', or 'Recursion വിശദീകരിക്കാമോ?')..."
                                 KeyDown="OnPromptKeyDown"
                                 VerticalAlignment="Center"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Click="OnSendClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE724;" FontSize="13"/>
                                <TextBlock Text="Send"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════ Row 4: Status & Security Policy Bar ═════════ -->
        <Border Grid.Row="4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6,16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Security Policy: Manual Execution Required (Fail-Closed)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="•" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Autonomous Background Execution: Disabled" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Phase 2: Core Learning &amp; AI Tutor (Active)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>

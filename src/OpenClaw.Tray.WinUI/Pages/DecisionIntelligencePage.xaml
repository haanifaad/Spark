<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.DecisionIntelligencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="900">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Decision Intelligence"
                               Style="{StaticResource TitleTextBlockStyle}"
                               AutomationProperties.AutomationId="DecisionIntelligencePageTitle"/>
                    <TextBlock Text="Non-autoregressive System 1 decision engine powered by Laya. Executes typed choices, scoring, and binary classifications in a single sub-40ms forward pass without prompt hallucination."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Status Banner / InfoBar -->
                <InfoBar x:Name="RuntimeInfoBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Runtime Ready"
                         Message="Laya decision engine is operational."/>

                <!-- Master Enable Switch Card -->
                <toolkit:SettingsCard AutomationProperties.AutomationId="DecisionIntelligenceEnableCard">
                    <toolkit:SettingsCard.Header>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Enable Decision Intelligence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="When enabled, eligible SPARK subsystems (Sentinel safety reviewer, autonomous agent triage, and model routing) utilize Laya for reflex-speed evaluations. When disabled, SPARK seamlessly falls back to standard heuristics."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Content>
                        <ToggleSwitch x:Name="MasterToggle"
                                      IsOn="True"
                                      Toggled="OnMasterToggleToggled"
                                      AutomationProperties.Name="Enable Decision Intelligence"/>
                    </toolkit:SettingsCard.Content>
                </toolkit:SettingsCard>

                <!-- Hardware Compatibility Section -->
                <TextBlock Text="Hardware &amp; System Compatibility"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Text="CPU Architecture" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CpuText" Text="x64 (AVX2 / Multi-Threaded)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Text="RAM Compatibility" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RamText" Text="16 GB Installed (Compatible)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Hardware Acceleration" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="GpuText" Text="DirectML / High-Speed CPU" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Storage Volume" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DiskText" Text="45.2 GB Available (Requirement: ~1.8 GB)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RecheckCompatButton" Content="Recheck Hardware Compatibility" Click="OnRecheckCompatClick"/>
                            <TextBlock x:Name="CompatVerdictText" Text="System is 100% compatible with Laya." VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Installation & Model Management Section -->
                <TextBlock Text="Pretrained Model &amp; Runtime Management"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Selected Decision Checkpoint" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Choose the appropriate verified model checkpoint based on language requirements and task complexity."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ModelSelector" Grid.Column="1" MinWidth="240" SelectionChanged="OnModelSelectorChanged">
                                <ComboBoxItem Content="Laya English (ModernBERT-large, 421M)" Tag="laya-english" IsSelected="True"/>
                                <ComboBoxItem Content="Laya Multilingual (mmBERT-base, 100+ Langs)" Tag="laya-multilingual"/>
                                <ComboBoxItem Content="Laya Typed Decisions (Specialist, 421M)" Tag="laya-typed-decisions"/>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="RuntimeStatusText" Text="Status: Enabled &amp; Operational (v1.0.0-verified)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="ModelDetailsText" Text="Active Weights: convaiinnovations/laya (Verified SHA-256 Checksum)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ProgressRing x:Name="OperationProgressRing" Grid.Column="2" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Progress Bar during download / install -->
                        <StackPanel x:Name="DownloadProgressContainer" Spacing="4" Visibility="Collapsed">
                            <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="ProgressDetailText" Text="Downloading..." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button x:Name="InstallButton" Content="Download and Install" Style="{StaticResource AccentButtonStyle}" Click="OnInstallClick"/>
                            <Button x:Name="RestartButton" Content="Restart Runtime" Click="OnRestartClick"/>
                            <Button x:Name="CheckUpdateButton" Content="Check for Updates" Click="OnCheckUpdateClick"/>
                            <Button x:Name="UninstallButton" Content="Uninstall" Click="OnUninstallClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Runtime Diagnostics & Live Reflex Test -->
                <TextBlock Text="Runtime Diagnostics &amp; Verification"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Live Reflex Test" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Verify single forward pass decision classification across input text in real time."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBox x:Name="SampleInputBox" Header="Test State Text"
                                 Text="The user wants to transfer ₹15,000 to an external unknown bank account immediately."
                                 TextWrapping="Wrap" MinHeight="60"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RunTestButton" Content="Evaluate Single-Pass Decision" Style="{StaticResource AccentButtonStyle}" Click="OnRunTestClick"/>
                            <TextBlock x:Name="TestLatencyText" Text="" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <TextBlock x:Name="TestResultText" Text="Result will appear here after evaluation." FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Licensing & Attribution -->
                <TextBlock Text="Licensing, Copyright &amp; Attribution"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Laya Decision-Classification Engine" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Copyright (c) Nandha Kishore M / ConvAI Innovations. Distributed under the Apache License, Version 2.0."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Official Upstream Repository: https://github.com/NandhaKishorM/laya"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
